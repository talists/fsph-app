# Arquivo de exemplo. Copie para um arquivo chamado .env e preencha com suas credenciais.

# === Conexão com o DB MySQL (dentro do Docker) ===
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=COLOQUE_SUA_SENHA_AQUI
DB_DATABASE=gota_a_gota_db

# === JWT ===
JWT_SECRET=GERAR_UM_SEGREDO_FORTE_AQUI

# === Redis (dentro do Docker) ===
REDIS_HOST=cache
REDIS_PORT=6379

# === Credenciais do Cloudflare R2 ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# === Google OAuth 2.0 ===
GOOGLE_CLIENT_ID=

# === API FSPH ===
FSPH_API_URL=https://api.fsph.se.gov.br/apiinterface

# === Cron Jobs ===
CRON_SCHEDULE_ESTOQUE="*/30 * * * *"

# === Servidor ===
PORT=3333