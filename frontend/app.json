{
  "expo": {
    "name": "gotaagotafsph",
    "slug": "gotaagotafsph",
    "owner": "lauroaug",
    "version": "1.0.0",
    "description": "FSPH Test App - Sistema de doação de sangue",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gotaagotafsph",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lauroaug.gotaagotafsph"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lauroaug.gotaagotafsph",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "scheme": "gotaagotafsph"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A aplicação precisa acessar suas fotos para que você possa compartilhar imagens de suas doações.",
          "cameraPermission": "A aplicação precisa acessar sua câmera para que você possa tirar fotos de suas doações."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.896137778307-p0laedr2hc2cojn3lrtjfd3ri5tef2u7",
          "googleServicesFile": "./google-services.json"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "gradlePluginVersion": "7.3.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4326ba4c-8055-4933-9a10-fb4691fa8c4b"
      }
    }
  }
}
