{
  "expo": {
    "name": "fsph_test",
    "slug": "fsph_test",
    "owner": "lauroaug",
    "version": "1.0.0",
    "description": "FSPH Test App - Sistema de doação de sangue",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fsphtest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lauroaug.fsphtest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lauroaug.fsph_test",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A aplicação precisa acessar suas fotos para que você possa compartilhar imagens de suas doações.",
          "cameraPermission": "A aplicação precisa acessar sua câmera para que você possa tirar fotos de suas doações."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9252855c-c9a7-426a-8cb9-4b174dad82f3"
      }
    }
  }
}
